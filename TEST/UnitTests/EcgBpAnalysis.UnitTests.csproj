<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C7E9A4B1-3D52-4F68-9A10-5E8D2B7C4F31}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>EcgBpAnalysis.UnitTests</RootNamespace>
    <AssemblyName>EcgBpAnalysis.UnitTests</AssemblyName>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- MSTest 框架 -->
    <Reference Include="Microsoft.VisualStudio.TestPlatform.TestFramework, Version=14.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <HintPath>..\..\packages\MSTest.TestFramework.2.2.10\lib\net45\Microsoft.VisualStudio.TestPlatform.TestFramework.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions, Version=14.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <HintPath>..\..\packages\MSTest.TestFramework.2.2.10\lib\net45\Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- 产品程序集（引用已编译产物；产品大量 HintPath 指向 bin\Debug，故统一用 Debug） -->
    <Reference Include="Zoncare.Common">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\Zoncare.Common.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Zoncare.Utilities">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\Zoncare.Utilities.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Crc32.NET">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\Crc32.NET.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- SQLite 集成测试所需 -->
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\Microsoft.Data.Sqlite.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\SQLitePCLRaw.core.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\SQLitePCLRaw.batteries_v2.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\Microsoft.EntityFrameworkCore.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- 血压解析集成测试所需产品程序集 -->
    <Reference Include="Zoncare.DAL">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\Zoncare.DAL.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="AnalysisSystem.Base">
      <HintPath>..\..\EcgAnalyseStart\bin\Debug\AnalysisSystem.Base.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Crc32Tests.cs" />
    <Compile Include="BpDataFormatTests.cs" />
    <Compile Include="DbSmokeTests.cs" />
    <Compile Include="BpParseIntegrationTests.cs" />
    <Compile Include="DbCheckerIntegrationTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- 将产品运行时依赖（EF Core 传递依赖 + SQLitePCLRaw native provider）复制到测试输出目录。
       测试工程直接引用产品 DLL，但这些 DLL 的传递依赖不会被自动复制，
       集成测试（ZoncareEntities + SQLite）运行时需要它们。 -->
  <Target Name="CopyProductRuntimeDeps" AfterTargets="Build">
    <ItemGroup>
      <_ProductBin Include="..\..\EcgAnalyseStart\bin\$(Configuration)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProductBin)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>
</Project>
